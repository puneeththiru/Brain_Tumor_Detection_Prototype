{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "main.js",
      "use": "@vercel/static"
    },
    {
      "src": "gradient.png",
      "use": "@vercel/static"
    },
    {
      "src": "models/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/vlm.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/vlm",
      "dest": "/api/vlm.js"
    }
  ]
}